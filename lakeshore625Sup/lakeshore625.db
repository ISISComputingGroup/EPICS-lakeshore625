record(bo, "$(P)SIM")
{
    field(SCAN, "Passive")
    field(DTYP, "Soft Channel")
    field(ZNAM, "NO")
    field(ONAM, "YES")
    field(VAL, "$(RECSIM=0)")
    field(PINI, "YES")
}

record(bo, "$(P)DISABLE")
{
    field(DESC, "Disable comms")
    field(PINI, "YES")
    field(VAL, "$(DISABLE=0)")
    field(OMSL, "supervisory")
    field(ZNAM, "COMMS ENABLED")
    field(ONAM, "COMMS DISABLED")
}
################################################################################
#
# Common Interface Commands
#
################################################################################
# Clear Status System and Errors
#
record(seq, "$(P)STAT:CLEAR")
{
# will need to clear all event records
#
    field(DESC, "Clear Status System")
    field(SELM, "All")
    field(DOL1, "0")
    field(LNK1, "$(P)ERROR:CLEAR PP")
    field(DOL2, "0")
    field(LNK2, "$(P)INTER:CLEAR PP")
    field(DOL3, "0")
    field(LNK3, "$(P)STAT:REG:SP")
    field(DOL4, "0")
    field(LNK4, "$(P)STAT:OP:REG:SP")
    field(SDIS, "$(P)DISABLE")
}
################################################################################
# Clear interface command
#
record(bo, "$(P)INTER:CLEAR")
{
    field(DESC, "Clear Interface")
    field(DTYP, "stream")
    field(OUT,  "@lakeshore625.proto clear $(PORT)")
    field(ZNAM, "Clear")
    field(SDIS, "$(P)DISABLE")
}
################################################################################
# Standard Event Register
# ESR is cleared on read so we need to keep latched values
# Write 0 to :ESR to clear rather than :CLS 
#
record(mbboDirect, "$(P)STAT:ENABLE:SP")
{
    field(DESC, "Standard Event Enable")
    field(DTYP, "stream")
    field(OUT,  "@lakeshore625.proto set_ese $(PORT)")
    field(NOBT, "8")
    field(SDIS, "$(P)DISABLE")
}
record(mbbiDirect, "$(P)STAT:ENABLE")
{
    field(DESC, "Standard Event Enable")
    field(NOBT, "8")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_ese $(PORT)")
    field(SCAN, "5 second")
}
record(mbbiDirect, "$(P)STAT:REG:SP")
{
    field(DESC, "Standard Event Register") 
    field(NOBT, "8")
    field(INP,  "$(P)STAT:CALC PP")
    field(SCAN, "1 second")
}
record(calc, "$(P)STAT:CALC") # STAT:CALC
{
    field(CALC, "A|B")
    field(INPA, "$(P)STAT:REG:SP")
    field(INPB, "$(P)STAT:REG PP")
}
record(mbbiDirect, "$(P)STAT:REG")
{
    field(DESC, "Standard Event Register")
    field(NOBT, "8")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_esr $(PORT)")
}
################################################################################
# Identification String
# AMI model number and firmware revision code
#
record(stringin, "$(P)ID") 
{
    field(DESC, "Identification")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_id $(PORT)")
    field(SCAN, "10 second")
}
################################################################################
# Reset the Instrument
#
record(bo, "$(P)RESET")
{
    field(DESC, "Reset")
    field(DTYP, "stream")
    field(OUT,  "@lakeshore625.proto reset $(PORT)")
    field(ZNAM, "Reset")
    field(SDIS, "$(P)DISABLE")
}
################################################################################
# Status Byte Register
#
record(bi, "$(P)STAT:SUMM")
{
    field(DESC, "STB Summary bit")
    field(INP,  "$(P)STAT:BYTE.B6 PP")
    field(SCAN, "1 second")
    field(ZNAM, "OK")
    field(ONAM, "STB")
    field(OSV,  "MAJOR")
}
record(mbbiDirect, "$(P)STAT:BYTE")
{
    field(DESC, "Status Byte")
    field(NOBT, "8")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_stb $(PORT)")
}
