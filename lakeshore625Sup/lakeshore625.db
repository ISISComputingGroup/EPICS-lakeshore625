#
# Alarm Summary
#
################################################################################
# ALM - Maximum Alarm Severity
#
record(calc, "$(P)ALARM") 
{
    field(DESC, "Max Severity")
    field(SCAN, "1 second")
    field(CALC, "A+B+C+D+E+F")
    field(INPA, "$(P)STAT:SUMM MS")
    field(INPB, "$(P)STAT:QUENCH MS")
    field(INPC, "$(P)VOLT:MAG MS")
    field(INPD, "$(P)VOLT:SUP MS")
    field(INPE, "$(P)CURR:MAG MS")
    field(INPF, "$(P)ERROR:SUMM MS")
}
