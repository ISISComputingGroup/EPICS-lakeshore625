################################################################################
# Magnet Field
#
record(ai, "$(P)FIELD:MAG")
{
    field(DESC, "Magnet Field")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_field $(PORT)")
    field(SCAN, "1 second")
#    field(EGU,  "T")
    field(PREC, "4")
}
################################################################################
# Magnet Current
#
record(ai, "$(P)CURR:MAG")
{
    field(DESC, "Magnet Current")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_iout $(PORT)")
    field(SCAN, "1 second")
    field(EGU,  "A")
    field(PREC, "4")
    field(LOPR, "-60.0")
    field(HOPR, "60.0")
    field(LOLO, "-60.1001")
    field(HIHI, "60.1001")
    field(LLSV, "MAJOR")
    field(HHSV, "MAJOR")
    field(LOW,  "-60.0")
    field(HIGH, "60.0")
    field(LSV,  "MINOR")
    field(HSV,  "MINOR")
}
record(calcout, "$(P)HLIM:CALC")
{
    field(DESC, "upper limit")
    field(CALC, "((A+C)>(B-D))?(A+C):(B-D)")
    field(OUT,  "$(P)CURR:MAG.HIGH")
    field(INPA, "$(P)CURR")
    field(INPB, "$(P)CURR:MAG.HIGH")
    field(INPC, "1")
    field(INPD, "$(P)RAMPRATE")
    field(SCAN, "1 second")
    field(PHAS, "2")
}
record(calcout, "$(P)LLIM:CALC")
{
    field(DESC, "lower limit")
    field(CALC, "((A-C)<(B+D))?(A-C):(B+D)")
    field(OUT,  "$(P)CURR:MAG.LOW")
    field(INPA, "$(P)CURR")
    field(INPB, "$(P)CURR:MAG.LOW")
    field(INPC, "1")
    field(INPD, "$(P)RAMPRATE")
    field(SCAN, "1 second")
    field(PHAS, "2")
}
