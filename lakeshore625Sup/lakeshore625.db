################################################################################
# Last Current Setting when PSH was turned off
#
record(ai, "$(P)CURR:PSH:LAST")
{
    field(DESC, "Last Current Setting")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_pshis $(PORT)")
    field(SCAN, "10 second")
    field(EGU,  "mA")
    field(PREC, "4")
    field(LOPR, "0.0")
    field(HOPR, "100.0")
    field(LOLO, "-0.0001")
#    field(LOW,  "0.0")
    field(HIGH, "99.9999")
    field(HIHI, "100.0")
    field(LLSV, "MAJOR")
#    field(LSV,  "MINOR")
    field(HSV,  "MINOR")
    field(HHSV, "MAJOR")
}
################################################################################
# Persistent Switch Heater Parameters
#
record(calcout, "$(P)PSH:PARAM:SP")
{
    field(DESC, "PSH Parameters")
    field(DTYP, "stream")
    field(OUT,  "@lakeshore625.proto set_pshs $(PORT)")
    field(CALC, "A")
    field(INPA, "$(P)PSH:ENABLE:SP")
    field(INPB, "$(P)PSH:CURR:SP")
    field(INPC, "$(P)PSH:TIME:SP")
    field(SDIS, "$(P)DISABLE")
}
record(bo, "$(P)PSH:ENABLE:SP")
{
    field(DESC, "PSH Enable")
    field(ZNAM, "Disabled")
    field(ONAM, "Enabled")
    field(SDIS, "$(P)DISABLE")
    field(FLNK, "$(P)PSH:PARAM:SP")
}
record(bi, "$(P)PSH:ENABLE")
{
    field(DESC, "PSH Enabled")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_pshs($(P)) $(PORT)")
    field(SCAN, "5 second")
    field(ZNAM, "Disabled")
    field(ONAM, "Enabled")
    field(FLNK, "$(P)PSH:CURR")
}
record(longout, "$(P)PSH:CURR:SP")
{
    field(DESC, "PSH Current")
    field(EGU,  "mA")
    field(VAL,  "10")
    field(DRVL, "10")
    field(DRVH, "125")
    field(LOPR, "0")
    field(HOPR, "125")
    field(SDIS, "$(P)DISABLE")
    field(FLNK, "$(P)PSH:PARAM:SP")
}
record(longin, "$(P)PSH:CURR")
{
    field(DESC, "PSH Current")
    field(EGU,  "mA")
    field(LOPR, "0")
    field(HOPR, "125")
    field(LOLO, "9")
    field(HIHI, "126")
    field(LLSV, "MAJOR")
    field(HHSV, "MAJOR")
    field(FLNK, "$(P)PSH:TIME")
}
record(longout, "$(P)PSH:TIME:SP")
{
    field(DESC, "PSH Time")
    field(EGU,  "s")
    field(DRVL, "5")
    field(DRVH, "100")
    field(LOPR, "0")
    field(HOPR, "100")
    field(SDIS, "$(P)DISABLE")
    field(FLNK, "$(P)PSH:PARAM:SP")
}
record(longin, "$(P)PSH:TIME")
{
    field(DESC, "PSH Time")
    field(EGU,  "s")
    field(VAL,  "5")
    field(LOPR, "0")
    field(HOPR, "100")
    field(LOLO, "4")
    field(HIHI, "101")
    field(LLSV, "MAJOR")
    field(HHSV, "MAJOR")
}
