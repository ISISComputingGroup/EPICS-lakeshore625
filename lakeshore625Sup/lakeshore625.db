{
    field(DESC, "Status Byte Enable")
    field(DTYP, "stream")
    field(OUT,  "@lakeshore625.proto set_sre $(PORT)")
    field(NOBT, "8")
    field(SDIS, "$(P)DISABLE")
}
record(mbbiDirect, "$(P)STAT:REQ")
{
    field(DESC, "Status Byte Enable")
    field(NOBT, "8")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_sre $(PORT)")
    field(SCAN, "5 second")
}
################################################################################
# Trigger Event
#
record(bo, "$(P)TRIGGER")
{
    field(DESC, "Trigger Event")
    field(DTYP, "stream")
    field(OUT,  "@lakeshore625.proto trigger $(PORT)")
    field(ZNAM, "Trigger")
    field(SDIS, "$(P)DISABLE")
}
################################################################################
# Self Test Query
#
record(bi, "$(P)TEST")
{
    field(DESC, "Self Test")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_test $(PORT)")
    field(SCAN, "Passive")
    field(ZNAM, "OK")
    field(ONAM, "Error")
    field(OSV,  "MAJOR")
}
################################################################################
#
# Instrument Specific Commands
#
################################################################################
# Factory Defaults
#
record(bo, "$(P)DEFAULT")
{
    field(DESC, "Factory Defaults")
    field(DTYP, "stream")
    field(OUT,  "@lakeshore625.proto default $(PORT)")
    field(ZNAM, "Default")
    field(SDIS, "$(P)DISABLE")
}
################################################################################
# Clear Errors
#
record(seq, "$(P)ERROR:CLEAR")
{
    field(DESC, "Clear Errors")
    field(SELM, "All")
    field(DOL1, "0")
    field(LNK1, "$(P)ERROR:CLEAR:CMD PP")
    field(DOL2, "0")
    field(LNK2, "$(P)ERROR:HARDWARE:EVENT")
    field(DOL3, "0")
    field(LNK3, "$(P)ERROR:OP:EVENT")
    field(DOL4, "0")
    field(LNK4, "$(P)ERROR:PSH:EVENT")
    field(SDIS, "$(P)DISABLE")
}
record(bo, "$(P)ERROR:CLEAR:CMD")
{
    field(DESC, "Clear Errors")
    field(DTYP, "stream")
    field(OUT,  "@lakeshore625.proto clr_err $(PORT)")
    field(ZNAM, "Clear")
    field(SDIS, "$(P)DISABLE")
}
################################################################################
# Error Status Condition
#
record(calc, "$(P)ERROR:SUMM")
{
    field(DESC, "Error Summary")
    field(CALC, "A|B|C|D|E|F")
    field(INPA, "$(P)ERROR:STAT:HARDWARE PP")
    field(INPB, "$(P)ERROR:STAT:OP PP")
    field(INPC, "$(P)ERROR:STAT:PSH PP")
    field(INPD, "$(P)ERROR:HARDWARE:EVENT PP")
    field(INPE, "$(P)ERROR:OP:EVENT PP") 
    field(INPF, "$(P)ERROR:PSH:EVENT PP")
    field(SCAN, "1 second")
    field(LOLO, "-1")
    field(HIHI, "1")
    field(LLSV, "MAJOR")
    field(HHSV, "MAJOR")
}
record(mbbiDirect, "$(P)ERROR:STAT:HARDWARE")
{
    field(DESC, "Hardware Error Status")
    field(NOBT, "8")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_erst($(P)) $(PORT)")
#    field(SCAN, "1 second")
    field(FLNK, "$(P)ERROR:STAT:OP")
}
record(mbbiDirect, "$(P)ERROR:STAT:OP")
{
    field(DESC, "Operational Error Status")
    field(NOBT, "8")
    field(FLNK, "$(P)ERROR:STAT:PSH")
}
record(mbbiDirect, "$(P)ERROR:STAT:PSH")
{
    field(DESC, "PSH Error Status")
    field(NOBT, "8")
    field(FLNK, "$(P)CMD:PSH:OPEN")
}
record(bi, "$(P)CMD:PSH:OPEN")
{
    field(DESC, "PSH Open")
    field(INP,  "$(P)ERROR:STAT:PSH.B0")
    field(ZNAM, "OK")
    field(ONAM, "Open")
    field(OSV,  "MAJOR")
    field(FLNK, "$(P)CMD:PSH:SHORT")
}
record(bi, "$(P)CMD:PSH:SHORT")
{
    field(DESC, "PSH Open")
    field(INP,  "$(P)ERROR:STAT:PSH.B1")
    field(ZNAM, "OK")
    field(ONAM, "Short")
    field(OSV,  "MAJOR")
    field(FLNK, "$(P)STAT:QUENCH")
}
record(bi, "$(P)STAT:QUENCH")
{
    field(DESC, "Quench Detected")
    field(INP,  "$(P)ERROR:STAT:OP.B5")
    field(ZNAM, "OK")
    field(ONAM, "Detected")
    field(OSV,  "MAJOR")
}
