################################################################################
# Computed Magnetic Field Parameter
#
record(calcout, "$(P)FIELD:PARAM:SP")
{
    field(DESC, "Magnetic Field Parameter")
    field(DTYP, "stream")
    field(OUT,  "@lakeshore625.proto set_flds $(PORT)")
    field(CALC, "B")
    field(INPA, "$(P)FIELD:PARAM:CONSANT:SP")
    field(INPB, "$(P)FIELD:PARAM:UNITS:SP")
    field(SDIS, "$(P)DISABLE")
}
record(ao, "$(P)FIELD:PARAM:CONSTANT:SP")
{
    field(DESC, "Field Parameter Constant")
#    field(EGU,  "T/A")
    field(PREC, "4")
    field(SDIS, "$(P)DISABLE")
    field(FLNK, "$(P)FIELD:PARAM:SP")
}
record(ai, "$(P)FIELD:PARAM:CONSTANT")
{
    field(DESC, "Field Parameter Constant")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_flds($(P)) $(PORT)")
    field(SCAN, "10 second")
#    field(EGU,  "T/A")
    field(PREC, "4")
    field(FLNK, "$(P)FIELD:PARAM:UNITS")
}
record(bo, "$(P)FIELD:PARAM:UNITS:SP")
{
    field(DESC, "Field Parameter Units")
    field(ZNAM, "T/A")
    field(ONAM, "kG/A")
    field(SDIS, "$(P)DISABLE")
    field(FLNK, "$(P)FIELD:PARAM:SP")
}
record(bi, "$(P)FIELD:PARAM:UNITS")
{
    field(DESC, "Field Parameter Units")
    field(ZNAM, "T/A")
    field(ONAM, "kG/A")
    field(FLNK, "$(P)FIELD:UNITS")
}
record(bi, "$(P)FIELD:UNITS")
{
    field(DESC, "Field Units")
    field(INP, "$(P)FIELD:PARAM:UNITS")
    field(ZNAM, "T")
    field(ONAM, "G")
}
################################################################################
# Limit Output Settings
#
record(calcout, "$(P)LIMIT:SP")
{
    field(DESC, "Limit Output Settings")
    field(DTYP, "stream")
    field(OUT,  "@lakeshore625.proto set_lim $(PORT)")
    field(CALC, "A")
    field(INPA, "$(P)LIMIT:CURR:SP")
    field(INPB, "$(P)LIMIT:VOLT:SP")
    field(INPC, "$(P)LIMIT:RATE:SP")
    field(SDIS, "$(P)DISABLE")
}
record(ao, "$(P)LIMIT:CURR:SP")
{
    field(DESC, "Current Limit")
    field(EGU,  "A")
    field(PREC, "4")
    field(VAL,  "60.0")
    field(DRVL, "0.0")
    field(DRVH, "60.1")
    field(LOPR, "0.0")
    field(HOPR, "60.0")
    field(SDIS, "$(P)DISABLE")
    field(FLNK, "$(P)LIMIT:SP")
}
record(ai, "$(P)LIMIT:CURR")
{
    field(DESC, "Current Limit")
    field(DTYP, "stream")
    field(INP,  "@lakeshore625.proto get_lim($(P)) $(PORT)")
    field(SCAN, "5 second")
    field(EGU,  "A")
    field(PREC, "4")
    field(LOPR, "0.0")
    field(HOPR, "60.0")
    field(LOLO, "-0.0001")
    field(HIHI, "60.1001")
    field(LLSV, "MAJOR")
    field(HHSV, "MAJOR")
    field(FLNK, "$(P)LIMIT:VOLT")
}

record(ao, "$(P)LIMIT:VOLT:SP")
{
    field(DESC, "Voltage Limit")
    field(EGU,  "V")
    field(PREC, "4")
    field(VAL,  "2.0")
    field(DRVL, "0.1")
    field(DRVH, "5.0")
    field(LOPR, "0.0")
    field(HOPR, "5.0")
    field(SDIS, "$(P)DISABLE")
    field(FLNK, "$(P)LIMIT:SP") 
}
record(ai, "$(P)LIMIT:VOLT")
{
    field(DESC, "Voltage Limit")
    field(EGU,  "V")
    field(PREC, "4")
    field(LOPR, "0.0")
    field(HOPR, "5.0")
    field(LOLO, "0.0")
    field(HIHI, "5.0001")
    field(LLSV, "MAJOR")
    field(HHSV, "MAJOR")
    field(FLNK, "$(P)LIMIT:RATE") 
}
record(ao, "$(P)LIMIT:RATE:SP")
{
    field(DESC, "Rate Limit")
    field(EGU,  "A/s")
    field(PREC, "4")
    field(VAL,  "1.0")
    field(DRVL, "0.0001")
    field(DRVH, "99.999")
    field(LOPR, "0.0")
    field(HOPR, "100.0")
    field(SDIS, "$(P)DISABLE")
    field(FLNK, "$(P)LIMIT:SP")
}
record(ai, "$(P)LIMIT:RATE")
{
    field(DESC, "Rate Limit")
    field(EGU,  "A/s")
    field(PREC, "4")
    field(LOPR, "0.0")
    field(HOPR, "100.0")
    field(LOW,  "0.0")
    field(HIHI, "100.000")
    field(LLSV, "MAJOR")
    field(HHSV, "MAJOR")
    field(FLNK, "$(P)LIMIT:SEQ:SP")
}
record(seq, "$(P)LIMIT:SEQ:SP")
{
    field(DESC, "Set Warning Limits")
    field(SELM, "All")
    field(DOL1, "$(P)LIMIT:VOLT")
    field(LNK1, "$(P)VOLT:MAG.HIGH") # VREM
    field(DOL2, "$(P)LIMIT:VOLT")
    field(LNK2, "$(P)VOLT:SUP.HIGH") # VOUT
    field(DOL3, "$(P)LIMIT:VOLT")
    field(LNK3, "$(P)VOLT:COM.HIGH") # SETV
    field(DOL4, "$(P)CALC:VOLT:LOW PP")
    field(LNK4, "$(P)VOLT:MAG.LOW") # VREM

    field(DOL5, "$(P)LIMIT:CURR")
    field(LNK5, "$(P)CURR.HIGH") # SETI
    field(DOL6, "$(P)LIMIT:CURR")
    field(LNK6, "$(P)TRIG.HIGH") # TRIG
    field(DOL7, "$(P)CALC:CURR:LOW PP")
    field(LNK7, "$(P)CURR.LOW") # SETI

    field(DOL8, "$(P)LIMIT:RATE")
    field(LNK8, "$(P)RAMPRATE:SP.HIGH") # RATE
    field(DOL9, "$(P)LIMIT:RATE")
    field(LNK9, "$(P)RAMPRATE:PM.HIGH") # PERSISTENT MODE RATE
}
record(calcout, "$(P)CALC:VOLT:LOW")
{
    field(CALC, "-A")
    field(INPA, "$(P)LIMIT:VOLT")
    field(OUT,  "$(P)VOLT:SUP.LOW")
}
record(calcout, "$(P)CALC:CURR:LOW")
{
    field(CALC, "-A")
    field(INPA, "$(P)LIMIT:CURR")
    field(OUT, "$(P)CURR.LOW")
}
